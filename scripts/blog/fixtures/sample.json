        "type": "text",
        "plain_text": "exports.handler = async (event) => {\n  const request = event.Records[0].cf.request;\n  const token = request.headers[\"x-auth-token\"]?.[0]?.value;\n  if (!token || !verifySignature(token)) {\n    return { status: \"401\", statusDescription: \"Unauthorized\" };\n  }\n  return request; // pass through to origin\n};",
