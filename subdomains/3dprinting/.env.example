# Copy to .env (which is gitignored) and fill in real values.
# Never commit the real .env — it holds AWS credentials (and, in lan mode,
# the printer's access code).

# cloud (default): connects via your Bambu account. Run
#   docker compose run --rm --entrypoint python3 bambu-publisher bambu_cloud_login.py
# once before starting the service — see infra/3dprinting/SETUP.md.
# lan: direct to the printer, requires LAN-only + Developer Mode (disables
# Bambu Cloud entirely). Set BAMBU_CONNECTION_MODE=lan and fill in
# BAMBU_IP / BAMBU_ACCESS_CODE below if you want this instead.
BAMBU_CONNECTION_MODE=cloud
BAMBU_SERIAL=01P00A000000000

# lan mode only:
BAMBU_IP=192.168.1.50
BAMBU_ACCESS_CODE=12345678

# cloud mode only — used by bambu_cloud_login.py (password is prompted,
# never stored here):
BAMBU_CLOUD_EMAIL=you@example.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# From YouTube Studio > Go Live > Stream (use a persistent stream key so
# this never changes across restarts). See infra/3dprinting/SETUP.md §7.
YOUTUBE_STREAM_KEY=
YOUTUBE_VIDEO_ID=
